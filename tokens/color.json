{
  "$source": "mobile/lib/theme/app_theme.dart AppColors (cta-app) + docs/DESIGN_SYSTEM.md §2",
  "$note": "Values transcribed verbatim in M9b. No redesign. '{a.b}' is a reference resolved at build time.",
  "brand": {
    "gold400": "#FACC15",
    "gold500": "#F59E0B",
    "gold600": "#D97706",
    "gold700": "#B45309"
  },
  "neutral": {
    "50": "#F9FAFB",
    "100": "#F3F4F6",
    "200": "#E5E7EB",
    "300": "#D1D5DB",
    "500": "#6B7280",
    "600": "#4B5563",
    "700": "#374151",
    "800": "#1F2937",
    "900": "#111827"
  },
  "semantic": {
    "success": "#16A34A",
    "warning": "{brand.gold500}",
    "danger": "#DC2626",
    "info": "#0284C7"
  },
  "surface": {
    "onGold": "#451A03",
    "espresso": "#292018"
  },
  "chip": {
    "info": { "bg": "{neutral.100}", "fg": "{neutral.700}" },
    "success": { "bg": "#DCFCE7", "fg": "#166534" },
    "warning": { "bg": "#FEF3C7", "fg": "#92400E" },
    "danger": { "bg": "#FEE2E2", "fg": "#991B1B" }
  },
  "gradient": {
    "goldGradient": {
      "type": "linear",
      "begin": "topLeft",
      "end": "bottomRight",
      "cssAngleDeg": 135,
      "stops": [
        { "color": "{brand.gold400}" },
        { "color": "{brand.gold600}" }
      ]
    },
    "splashRadial": {
      "type": "radial",
      "center": [0, -0.4],
      "radius": 1.2,
      "stops": [
        { "color": "#FDE68A", "at": 0.0 },
        { "color": "{brand.gold500}", "at": 0.55 },
        { "color": "{brand.gold600}", "at": 1.0 }
      ]
    }
  }
}
